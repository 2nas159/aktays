# Canonical origin, used for sitemap.xml, robots.txt and metadata.
#
# Optional. A bare host ("aktays.com") works as well as a full origin, and an
# unusable value is ignored with a warning rather than failing the build.
# When unset, Vercel's own VERCEL_PROJECT_PRODUCTION_URL is used, so preview
# and production deployments get correct canonical URLs with no configuration.
NEXT_PUBLIC_SITE_URL=https://aktays.com
