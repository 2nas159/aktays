# ---------------------------------------------------------------------------
# Canonical origin, used for sitemap.xml, robots.txt and metadata.
#
# Optional. A bare host ("aktays.com") works as well as a full origin, and an
# unusable value is ignored with a warning rather than failing the build.
# When unset, Vercel's own VERCEL_PROJECT_PRODUCTION_URL is used, so preview
# and production deployments get correct canonical URLs with no configuration.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://aktays.com

# ---------------------------------------------------------------------------
# Contact form delivery (Resend — https://resend.com).
#
# Without these the form stays up but returns a "not connected" message telling
# the visitor to email directly, and logs the enquiry to the server so nothing
# is silently lost. Set all three to turn delivery on.
# ---------------------------------------------------------------------------

# API key from the Resend dashboard.
RESEND_API_KEY=

# The address enquiries are sent FROM. Must be on a domain you have verified
# in Resend, e.g. "Aktays <hello@aktays.com>". Sending from an unverified
# domain is rejected by Resend.
CONTACT_FROM_EMAIL=

# Where enquiries land. Defaults to the address in src/lib/company.ts.
CONTACT_TO_EMAIL=
